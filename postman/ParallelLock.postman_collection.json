{
	"info": {
		"_postman_id": "8d3e91a0-7164-4bf8-b982-998811223344",
		"name": "ParallelLock API",
		"description": "Postman collection covering all core endpoints of the ParallelLock high-concurrency ticket booking engine, including sliding-window rate limit headers (X-RateLimit-Limit, X-RateLimit-Remaining, X-RateLimit-Reset, Retry-After).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:4000/api/v1",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		},
		{
			"key": "movieId",
			"value": "1",
			"type": "string"
		},
		{
			"key": "showId",
			"value": "1",
			"type": "string"
		},
		{
			"key": "bookingId",
			"value": "1",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Idempotency-Key",
								"value": "idem-key-{{$guid}}",
								"description": "Optional client-generated idempotency key (1-100 chars) ensuring safe retries without duplicate bookings."
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"testuser@example.com\",\n  \"password\": \"Password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "register"]
						},
						"description": "Registers a new user account with Argon2id password hashing and returns a JWT token."
					},
					"response": []
				},
				{
					"name": "Login User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"if (res.token) {",
									"    pm.collectionVariables.set(\"token\", res.token);",
									"    console.log(\"Saved JWT token to collection variable: token\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Idempotency-Key",
								"value": "idem-key-{{$guid}}",
								"description": "Optional client-generated idempotency key (1-100 chars) ensuring safe retries without duplicate bookings."
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"alice@example.com\",\n  \"password\": \"Password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						},
						"description": "Authenticates user credentials and automatically updates the collection {{token}} variable upon success."
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Catalog",
			"item": [
				{
					"name": "List All Movies",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/movies",
							"host": ["{{baseUrl}}"],
							"path": ["movies"]
						},
						"description": "Returns list of all movies in catalog with posters, genres, ratings, and running times."
					},
					"response": []
				},
				{
					"name": "List Shows for Movie",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/movies/{{movieId}}/shows",
							"host": ["{{baseUrl}}"],
							"path": ["movies", "{{movieId}}", "shows"]
						},
						"description": "Returns upcoming showtimes for the specified movie within the next 3 days."
					},
					"response": []
				}
			]
		},
		{
			"name": "3. Seats",
			"item": [
				{
					"name": "Get Seat Map for Show",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/shows/{{showId}}/seats",
							"host": ["{{baseUrl}}"],
							"path": ["shows", "{{showId}}", "seats"]
						},
						"description": "Returns the physical seating grid, pricing tiers, and dynamic availability (AVAILABLE, MINE, UNAVAILABLE, BLOCKED)."
					},
					"response": []
				}
			]
		},
		{
			"name": "4. Booking & Holds",
			"item": [
				{
					"name": "Hold Seats (Transactional)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const res = pm.response.json();",
									"if (res.booking && res.booking.id) {",
									"    pm.collectionVariables.set(\"bookingId\", res.booking.id);",
									"    console.log(\"Saved booking ID: \" + res.booking.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Idempotency-Key",
								"value": "idem-key-{{$guid}}",
								"description": "Optional client-generated idempotency key (1-100 chars) ensuring safe retries without duplicate bookings."
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"seatIds\": [7, 8]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/shows/{{showId}}/holds",
							"host": ["{{baseUrl}}"],
							"path": ["shows", "{{showId}}", "holds"]
						},
						"description": "Places an 8-minute atomic hold on seats using row-level locking (SELECT ... FOR UPDATE). Saves bookingId."
					},
					"response": []
				},
				{
					"name": "Get Booking Details",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/bookings/{{bookingId}}",
							"host": ["{{baseUrl}}"],
							"path": ["bookings", "{{bookingId}}"]
						},
						"description": "Fetches booking status, reserved seats, ticket price, and hold expiration timestamp."
					},
					"response": []
				},
				{
					"name": "Pay & Confirm Booking",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Idempotency-Key",
								"value": "idem-key-{{$guid}}",
								"description": "Optional client-generated idempotency key (1-100 chars) ensuring safe retries without duplicate bookings."
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"method\": \"CARD\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/bookings/{{bookingId}}/pay",
							"host": ["{{baseUrl}}"],
							"path": ["bookings", "{{bookingId}}", "pay"]
						},
						"description": "Confirms payment for an active hold. Uses a two-phase PAYMENT_PENDING state machine with payment_started_at to gate concurrent requests, extends hold by 3 minutes during payment execution, and lazily recovers stale in-flight payments after 2 minutes."
					},
					"response": []
				},
				{
					"name": "Release Held Seats",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/bookings/{{bookingId}}",
							"host": ["{{baseUrl}}"],
							"path": ["bookings", "{{bookingId}}"]
						},
						"description": "Releases held seats immediately back to the available seat inventory and cancels the booking. Returns 409 INVALID_STATE if payment is actively in flight (PAYMENT_PENDING)."
					},
					"response": []
				}
			]
		},
		{
			"name": "5. User",
			"item": [
				{
					"name": "Get My Bookings",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/me/bookings",
							"host": ["{{baseUrl}}"],
							"path": ["me", "bookings"]
						},
						"description": "Lists the authenticated user's confirmed bookings and tickets, newest first."
					},
					"response": []
				}
			]
		},
		{
			"name": "5. Payments & Webhooks (P2-M3)",
			"item": [
				{
					"name": "Pay Booking (sync)",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{token}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"method\": \"MOCK\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/bookings/{{bookingId}}/pay",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"bookings",
								"{{bookingId}}",
								"pay"
							]
						},
						"description": "Three-phase payment. Returns booking + payment.providerRef. Status 200 (sync confirmed) or 202 (async PAYMENT_PENDING, waiting for webhook)."
					},
					"response": []
				},
				{
					"name": "Webhook – Payment Succeeded",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "x-signature",
								"value": "REPLACE_WITH_HMAC_SHA256_HEX",
								"description": "HMAC-SHA256 of raw body with WEBHOOK_SECRET"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"id\": \"evt_test_001\",\n  \"event\": \"payment.succeeded\",\n  \"data\": {\n    \"provider_ref\": \"REPLACE_WITH_PROVIDER_REF\",\n    \"provider_payment_id\": \"pay_test_001\",\n    \"amount_cents\": 32000,\n    \"currency\": \"INR\"\n  },\n  \"created_at\": \"2026-11-23T10:00:00Z\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/webhooks/payments",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"webhooks",
								"payments"
							]
						},
						"description": "Receives payment result. x-signature must be HMAC-SHA256(raw body, WEBHOOK_SECRET) in hex. Deduped by event id. Runs same finalize logic as sync pay."
					},
					"response": []
				},
				{
					"name": "Webhook – Payment Failed",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "x-signature",
								"value": "REPLACE_WITH_HMAC_SHA256_HEX"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"id\": \"evt_test_fail_001\",\n  \"event\": \"payment.failed\",\n  \"data\": {\n    \"provider_ref\": \"REPLACE_WITH_PROVIDER_REF\",\n    \"amount_cents\": 32000,\n    \"currency\": \"INR\"\n  },\n  \"created_at\": \"2026-11-23T10:00:00Z\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/webhooks/payments",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"webhooks",
								"payments"
							]
						},
						"description": "Marks payment FAILED, reverts booking to CREATED. FAILED after SUCCEEDED is ignored."
					},
					"response": []
				}
			]
		}
	]
}
