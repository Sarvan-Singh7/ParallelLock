# Copy this file to .env and fill in your values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/parallellock
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/parallellock_test
JWT_SECRET=replace_with_at_least_32_random_characters
WEBHOOK_SECRET=replace_with_at_least_16_random_characters
PORT=4000
HOLD_SECONDS=480
CLIENT_ORIGIN=http://localhost:5173
# Set to true to simulate a payment gateway failure (dev/test only)
MOCK_PAYMENT_FAIL=false
MOCK_PAYMENT_MODE=sync
# Rate limiting & proxy settings
# TRUST_PROXY=1 # Set to integer hop-count if running behind a reverse proxy (e.g. Render, AWS ALB, Cloudflare)
ENABLE_RATE_LIMITER=true
RATE_LIMIT_HOLDS_PER_MIN=10
RATE_LIMIT_LOGIN_FAIL_IP_PER_15MIN=60
RATE_LIMIT_LOGIN_FAIL_EMAIL_PER_15MIN=10
RATE_LIMIT_REGISTER_PER_10MIN=30
SWEEPER_INTERVAL_MS=30000
