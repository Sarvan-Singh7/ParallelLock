# Copy this file to .env and fill in your values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/parallellock
TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/parallellock_test
JWT_SECRET=replace_with_at_least_32_random_characters
PORT=4000
HOLD_SECONDS=480
CLIENT_ORIGIN=http://localhost:5173
# Set to true to simulate a payment gateway failure (dev/test only)
MOCK_PAYMENT_FAIL=false
