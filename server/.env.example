# ==============================================================================
# ParallelLock – Environment Configuration (.env)
# ==============================================================================
# Instructions: Copy this file to .env and supply your environment-specific values.
# In PRODUCTION (NODE_ENV=production):
#   - The server will REFUSE to start if default or insecure dev secrets are used.
#   - JWT_SECRET must be at least 32 characters long.
#   - WEBHOOK_SECRET must be a cryptographically secure random string.
# ==============================================================================

# Core Database Connection String (PostgreSQL 16+)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/parallellock

# Test Database (used only by Vitest test runner when NODE_ENV=test)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/parallellock_test

# Authentication & Security Secrets
# In production, generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters in production. Never commit production keys to git!
JWT_SECRET=super_secret_development_key_minimum_32_characters_long_12345

# Payment Gateway Webhook HMAC Secret
# Used to verify SHA256 HMAC signatures on incoming POST /api/v1/webhooks/payments
WEBHOOK_SECRET=at_least_16_chars_random_string

# Server & Network Configuration
PORT=4000
NODE_ENV=development

# Allowed Frontend Client Origin for CORS Whitelist
# In production, set to your frontend domain (e.g., https://tickets.example.com)
CLIENT_ORIGIN=http://localhost:5173

# Seat Hold Expiration Window (seconds)
# Default is 480 seconds (8 minutes)
HOLD_SECONDS=480

# Reverse Proxy Trust Configuration (R1 / D1)
# Set to the integer number of upstream reverse proxies (e.g. 1 behind Render, Cloudflare, or AWS ALB)
# Leave unset or empty if the application connects directly to clients.
# TRUST_PROXY=1

# Rate Limiting Configuration (R1)
# Enabled by default when NODE_ENV!=test.
ENABLE_RATE_LIMITER=true
RATE_LIMIT_HOLDS_PER_MIN=10
RATE_LIMIT_LOGIN_FAIL_IP_PER_15MIN=60
RATE_LIMIT_LOGIN_FAIL_EMAIL_PER_15MIN=10
RATE_LIMIT_REGISTER_PER_10MIN=30

# Background Sweeper Interval (milliseconds)
# Interval at which the advisory-locked sweeper cleans up expired holds and retries refunds.
SWEEPER_INTERVAL_MS=30000

# Mock Payment Gateway Settings (development/testing only)
# MOCK_PAYMENT_MODE: 'sync' (instant response) or 'async' (webhook reconciliation)
MOCK_PAYMENT_MODE=sync
MOCK_PAYMENT_FAIL=false
MOCK_PAYMENT_DELAY_MS=0
