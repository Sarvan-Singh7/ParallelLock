{
  "name": "parallellock-server",
  "version": "1.0.0",
  "description": "ParallelLock API server – Phase 1",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node --env-file=.env src/server.js",
    "migrate": "node --env-file=.env src/db/migrate.js",
    "seed": "node --env-file=.env src/db/seeds/seed.js",
    "test": "node --env-file=.env ./node_modules/vitest/vitest.mjs run --fileParallelism=false --reporter=verbose",
    "test:concurrency": "node --env-file=.env ./node_modules/vitest/vitest.mjs run --fileParallelism=false --reporter=verbose tests/concurrency",
    "demo:parallel": "node --env-file=.env scripts/demoParallel.js",
    "demo:unsafe": "node --env-file=.env scripts/demoUnsafe.js"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^2.0.5"
  }
}
